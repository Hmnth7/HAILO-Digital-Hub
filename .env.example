# HAILO Digital Hub - Production Environment Variables
# Set this to your deployed production domain (e.g., https://your-app.vercel.app)
# This domain is used to generate mobile-scannable QR codes.
VITE_PUBLIC_URL=https://your-domain.com

# Firebase Web Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=hailo-digital-hub-c33c1
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

